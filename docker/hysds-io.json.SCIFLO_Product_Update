    {
      "name": "pge_scratch_dir",
      "from": "value",
      "type": "text",
      "value": "pge_scratch_dir",
      "default": "pge_scratch_dir"
    },
    {
      "name": "container_home",
      "from": "value",
      "type": "text",
      "value": "/home/mamba",
