{
  "label": "DISP-S1 K-Cycle Evaluator",
  "allowed_accounts": ["ops"],
  "enable_dedup": true,
  "params": [
    {
      "name": "product_paths",
      "from": "dataset_jpath:_source",
      "lambda": "lambda ds: next((url for url in ds['urls'] if url.startswith('s3://')), '')"
    },
    {
      "name": "product_metadata",
      "from": "dataset_jpath:_source",
      "lambda": "lambda ds: { 'metadata': ds['metadata'] }"
    },
    {
      "name": "dataset_type",
      "from": "dataset_jpath:_source.dataset"
    },
    {
      "name": "input_dataset_id",
      "type": "text",
      "from": "dataset_jpath:_id"
    },
    {
      "name": "k",
      "from": "value",
      "type": "number",
      "value": "15"
    },
    {
      "name": "m",
      "from": "value",
      "type": "number",
      "value": "6"
    }
  ]
}
