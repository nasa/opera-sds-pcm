{
  "order": 0,
  "index_patterns": [
    "{{ prefix }}_*"
  ],
  "settings": {
    "index": {
      "refresh_interval": "5s",
      "number_of_shards": 5,
      "number_of_replicas": 1
    },
    "analysis": {
      "analyzer": {
        "default": {
          "filter": [
            "lowercase",
            "word_delimiter"
          ],
          "tokenizer": "keyword"
        }
      }
    }
  },
  "mappings": {
    "dynamic_templates": [
      {
        "strings": {
          "match_mapping_type": "string",
          "mapping": {
            "norms": false,
            "type": "text",
            "copy_to": "text_fields",
            "fields": {
              "keyword": {
                "type": "keyword",
                "ignore_above": 256
              }
            }
          },
          "match": "*"
        }
      }
    ],
    "properties": {
      "browse_urls": {
        "type": "text",
        "copy_to": "text_fields"
      },
      "urls": {
        "type": "text",
        "copy_to": "text_fields"
      },
      "location": {
        "tree": "quadtree",
        "type": "geo_shape",
        "ignore_z_value": true
      },
      "center": {
        "tree": "quadtree",
        "type": "geo_shape"
      },
      "starttime": {
        "type": "date"
      },
      "endtime": {
        "type": "date"
      },
      "creation_timestamp": {
        "type": "date"
      },
      "metadata": {
        "properties": {
          "context": {
            "type": "object",
            "enabled": false
          },
          "FileSize": {
            "type": "float"
          },
          "product_id": {
            "type": "text",
            "copy_to": "text_fields"
          },
          "data_take_id": {
            "type": "text",
           "copy_to": "text_fields"
          },
          "Files": {
            "properties": {
              "lineage": {
                "type": "text",
                "index": false
              },
              "runconfig": {
                "type": "object",
                "enabled": false
              },
              "tags": {
                "type": "text",
                "index": false
              },
              "FileLocation": {
                "type": "text",
                "index": false
              }
            }
          },
          "lineage": {
            "type": "text",
            "index": false
          },
          "runconfig": {
            "type": "object",
            "enabled": false
          },
          "accountability": {
            "type": "object",
            "enabled": false
          }
        }
      },
      "prov": {
        "type": "object",
        "enabled": false
      },
      "text_fields": {
        "type": "text"
      }
    }
  },
  "aliases": {
    "{{ alias }}": {}
  }
}
