{
  "policy": {
    "description": "Rolling Mozart indices from hot -> warm (force-merged) -> cold (shrunk to 1 shard) -> close -> delete",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": {
              "min_index_age": "5d"
            }
          }
        ]
      },
      {
        "name": "warm",
        "actions": [
          {
            "force_merge": {
              "max_num_segments": 1
            }
          },
          {
            "read_write": {}
          }
        ],
        "transitions": [
          {
            "state_name": "cold",
            "conditions": {
              "min_index_age": "20d"
            }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "shrink": {
              "num_new_shards": 1
            }
          }
        ],
        "transitions": [
          {
            "state_name": "close",
            "conditions": {
              "min_index_age": "30d"
            }
          }
        ]
      },
      {
        "name": "close",
        "actions": [
          {
            "close": {}
          }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "40d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "delete": {}
          }
        ]
      }
    ],
    "ism_template": {
      "index_patterns": [
        "job_status-*",
        "task_status-*",
        "worker_status-*",
        "event_status-*",
        "top_queries-*"
      ],
      "priority": 100
    }
  }
}
