{
  "index_patterns": ["grq_*_dswx_s1-state-config-*", "grq_*_dswx_s1-expired-state-config-*"],
  "priority": 6,
  "template": {
    "aliases":{
       "grq":{}
    },
    "settings": {
      "number_of_shards": 8
    },
    "mappings": {
      "properties": {
        "location": {
          "tree": "quadtree",
          "type": "geo_shape",
          "ignore_z_value": true
        },
        "metadata": {
          "properties": {
            "state_config_type":        {"type": "keyword"},
            "mgrs_set_id":              {"type": "keyword"},
            "cycle_number":             {"type": "integer"},
            "sensor":                   {"type": "keyword"},
            "expected_bursts":          {"type": "keyword"},
            "found_bursts":             {"type": "keyword"},
            "missing_bursts":           {"type": "keyword"},
            "polarization":             {"type": "keyword"},
            "land_ocean_flag":          {"type": "keyword"},
            "bounding_box":             {"type": "float"},
            "coverage_area":            {"type": "float"},
            "rtc_s3_product_paths":     {"type": "keyword"},
            "coverage_actual":          {"type": "integer"},
            "coverage_expected":        {"type": "integer"},
            "is_complete":              {"type": "boolean"},
            "completeness_reason":      {"type": "keyword"},
            "expiration_date":          {"type": "date", "format": "yyyyMMdd"},
            "is_expired":               {"type": "boolean"},
            "is_skipped":               {"type": "boolean"},
            "skipped_reason":           {"type": "keyword"}
          }
        }
      }
    }
  }
}
