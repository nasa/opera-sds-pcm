{
  "policy": {
    "description": "Rolling Mozart indices from hot -> warm -> cold (retained indefinitely)",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": {
              "min_index_age": "30d"
            }
          }
        ]
      },
      {
        "name": "warm",
        "actions": [],
        "transitions": [
          {
            "state_name": "cold",
            "conditions": {
              "min_index_age": "90d"
            }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "read_only": {}
          }
        ]
      }
    ],
    "ism_template": {
      "index_patterns": [
        "cslc_catalog", "cslc_catalog-*",
        "hls_spatial_catalog", "hls_spatial_catalog-*",
        "hls_catalog", "hls_catalog-*",
        "jobs_accountability_catalog", "jobs_accountability_catalog-*",
        "k_cslc_catalog", "k_cslc_catalog-*",
        "rtc_catalog", "rtc_catalog-*",
        "slc_catalog", "slc_catalog-*",
        "slc_spatial_catalog", "slc_spatial_catalog-*",
        "cmr_rtc_cache", "batch_proc",
        "grq_*"
      ],
      "priority": 1
    }
  }
}
