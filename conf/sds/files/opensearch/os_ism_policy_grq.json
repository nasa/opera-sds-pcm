{
  "policy": {
    "description": "Rolling Mozart indices from hot -> warm (force merged) -> cold (retained indefinitely)",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": {
              "min_index_age": "120d"
            }
          }
        ]
      },
      {
        "name": "warm",
        "actions": [
          {
            "force_merge": {
              "max_num_segments": 1
            }
          },
          {
            "read_write": {}
          }
        ],
        "transitions": [
          {
            "state_name": "cold",
            "conditions": {
              "min_index_age": "365d"
            }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "read_only": {}
          }
        ]
      }
    ],
    "ism_template": {
      "index_patterns": [
        "cslc_catalog", "cslc_catalog-*", "cslc_static_catalog-*",
        "hls_spatial_catalog", "hls_spatial_catalog-*",
        "hls_catalog", "hls_catalog-*",
        "jobs_accountability_catalog", "jobs_accountability_catalog-*",
        "k_cslc_catalog", "k_cslc_catalog-*",
        "rtc_catalog", "rtc_catalog-*",
        "rtc_for_dist_catalog", "rtc_for_dist_catalog-*",
        "slc_catalog", "slc_catalog-*",
        "slc_spatial_catalog", "slc_spatial_catalog-*",
        "cmr_rtc_cache", "batch_proc",
        "grq_*"
      ],
      "priority": 100
    }
  }
}
