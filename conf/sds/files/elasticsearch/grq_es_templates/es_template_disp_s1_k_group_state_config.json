{
  "index_patterns": ["grq_*_disp-s1-k-group-state-config"],
  "template": {
    "settings": {
      "index.lifecycle.name": "opera_grq_ilm_policy",
      "number_of_shards": 8
    },
    "mappings": {
      "properties": {
        "metadata": {
          "properties": {
            "state_config_type":        {"type": "keyword"},
            "frame_id":                 {"type": "integer"},
            "k_group_index":            {"type": "integer"},
            "k":                        {"type": "integer"},
            "m":                        {"type": "integer"},
            "acquisition_cycles":       {"type": "integer"},
            "cycle_state_config_ids":   {"type": "keyword"},
            "cycles_complete":          {"type": "integer"},
            "cycles_expected":          {"type": "integer"},
            "all_cycles_complete":      {"type": "boolean"},
            "total_cslcs_found":        {"type": "integer"},
            "total_cslcs_expected":     {"type": "integer"},
            "compressed_cslc_satisfied": {"type": "boolean"},
            "compressed_cslc_ids":      {"type": "keyword"},
            "is_complete":              {"type": "boolean"},
            "force_submit":             {"type": "boolean"},
            "download_job_id":          {"type": "keyword"}
          }
        }
      }
    }
  }
}
