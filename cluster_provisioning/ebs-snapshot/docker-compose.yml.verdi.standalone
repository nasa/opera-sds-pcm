version: '2.2'
services:
  verdi:
    hostname: verdi
    container_name: verdi
    image: hysds/verdi
    init: true
    user: "$${HOST_UID}:$${HOST_GID}"
    ports:
      - "8085:8085"
      - "9001:9001"
    environment:
      - AWS_CONFIG_FILE=/root/.aws/config
      - AWS_METADATA_SERVICE_TIMEOUT=10
      - AWS_METADATA_SERVICE_NUM_ATTEMPTS=5
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock"
