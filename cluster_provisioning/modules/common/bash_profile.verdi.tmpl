# .bash_profile

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
        . ~/.bashrc
fi

# User specific environment and startup programs
export LD_LIBRARY_PATH=/usr/lib:/usr/lib64:$HOME/conda/lib:/usr/local/lib:$LD_LIBRARY_PATH

PATH=$HOME/conda/bin:$PATH:$HOME/.local/bin:$HOME/bin

export PATH

# Resolves a celeryconfig.py not found issue during provisioning.
# pip 21.3+ strict editable mode hides bare .py siblings
# (celeryconfig.py) of the hysds package; PYTHONPATH bypasses that.
# Pattern matches NISAR (commit 55d3185de) and SWOT.
export PYTHONPATH=$PYTHONPATH:$HOME/verdi/ops/hysds

# source verdi
export VERDI_DIR=$HOME/verdi
source $VERDI_DIR/bin/activate
